{
  "name": "fl-fave",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && next dev --webpack",
    "build": "node scripts/prepare-assets.mjs && next build --webpack && node scripts/build-sw.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:fixtures": "node scripts/fetch-test-fixtures.mjs",
    "pretest:e2e": "npm run test:fixtures",
    "format:check": "prettier --check src scripts tests *.ts *.mjs README.md"
  },
  "dependencies": {
    "@uswriting/exiftool": "^1.0.9",
    "dexie": "^4.4.5",
    "exifr": "^7.1.3",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
